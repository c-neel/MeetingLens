<mxfile host="app.diagrams.net" modified="2026-09-18T08:30:00.000Z" agent="MeetingLens" version="21.0.0" type="device">
  <diagram id="meetinglens-architecture" name="MeetingLens System Architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#0B0F19" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title Banner -->
        <mxCell id="arch_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px; color: #38BDF8;&quot;&gt;MeetingLens • 4-Tier System Architecture Diagram&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;Modular Layered Architecture: Frontend Client, API Gateway, Intelligence Layer &amp;amp; Persistence Layer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;strokeWidth=2;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="900" height="70" as="geometry"/>
        </mxCell>

