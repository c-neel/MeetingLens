        </mxCell>

        <mxCell id="db_users" value="&lt;b&gt;users Table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;id, name, email, password_hash, created_at&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1E293B;strokeColor=#10B981;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="layer_db">
