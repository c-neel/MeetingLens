          <mxGeometry x="30" y="55" width="210" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="c_details" value="&lt;b&gt;Meeting Details Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;Smart Transcripts &amp;amp; Summaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="layer_client">
